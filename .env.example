# The P0 OSS Univer Sheets integration needs no license credentials.
# DO NOT place any keys in NEXT_PUBLIC_ variables or commit real secrets.
# UNIVER_LICENSE and UNIVER_LICENSE_KEY are server-side only when required.
UNIVER_LICENSE=
UNIVER_LICENSE_KEY=

# Only needed in a later phase if Ant Ling inference runs INSIDE the app.
# Ant Ling used to power a coding tool is a separate integration.
ANT_LING_API_KEY=
