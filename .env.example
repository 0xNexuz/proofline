# Univer Sheets works without any license (open-source features only).
# Never commit real values. Never put server secrets in NEXT_PUBLIC_ variables.

# Univer browser license: the full contents of license.txt. Univer's Web SDK is designed to
# receive this in the browser; it enables licensed features (charts, pivot tables, etc.).
# It is inlined at build time, so redeploy after changing it.
NEXT_PUBLIC_UNIVER_LICENSE=
# Local only: set to 1 to try licensed features without a license (Univer shows a watermark).
NEXT_PUBLIC_UNIVER_PRO_PREVIEW=

# Server-only Univer secrets for a future Univer server (collaboration, XLSX import/export).
# UNIVER_LICENSE = license.txt, UNIVER_LICENSE_KEY = licenseKey.txt. Never prefix with NEXT_PUBLIC_.
UNIVER_LICENSE=
UNIVER_LICENSE_KEY=

# Only needed in a later phase if Ant Ling inference runs INSIDE the app.
# Ant Ling used to power a coding tool is a separate integration.
ANT_LING_API_KEY=

# Optional local private SQLite directory. Keep it outside public/ and Git.
PROOFLINE_DATA_DIR=

# Required on Vercel: private PostgreSQL connection supplied by its storage integration.
# Leave unset for the browser-local SQLite development server.
DATABASE_URL=
